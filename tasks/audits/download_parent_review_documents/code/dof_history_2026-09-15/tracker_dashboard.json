view4, review5]\n \nfor (var i in dates) {\n  if (dates[i] != null && dates[i] > max_reviewdate) {\n    max_reviewdate = dates[i]\n  }\n}\n\nvar review_str = \"N/A\"\nif (max_reviewdate > Date(1900, 0, 1)) {\n  review_str = Text(max_reviewdate, 'M/D/Y')\n}\n//Max Rejected Date\nvar reject1 = $datapoint.Rejected_Date;\nvar reject2 = $datapoint.Rejected_Date2;\nvar reject3 = $datapoint.Rejected_Date3;\nvar reject4 = $datapoint.Rejected_Date4;\nvar reject5 = $datapoint.Rejected_Date5;\n\nvar max_rejdate = Date(1900, 0, 1);\nvar rejdates = [reject1, reject2, reject3, reject4, reject5]\n \nfor (var i in rejdates) {\n  if (rejdates[i] != null && rejdates[i] > max_rejdate) {\n    max_rejdate = rejdates[i]\n  }\n}\n\nvar reject_str = \"N/A\"\nif (max_rejdate > Date(1900, 0, 1)) {\n  reject_str = Text(max_rejdate, 'M/D/Y')\n}\n//Max Resubmitted Date\nvar resubmit1 = $datapoint.Resubmission_Date;\nvar resubmit2 = $datapoint.Resubmission_Date2;\nvar resubmit3 = $datapoint.Resubmission_Date3;\nvar resubmit4 = $datapoint.Resubmission_Date4;\nvar resubmit5 = $datapoint.Resubmission_Date5;\n\nvar max_resubdate = Date(1900, 0, 1);\nvar resubdates = [resubmit1, resubmit2, resubmit3, resubmit4, resubmit5]\n \nfor (var i in resubdates) {\n  if (resubdates[i] != null && resubdates[i] > max_resubdate) {\n    max_resubdate = resubdates[i]\n  }\n}\n\nvar resub_str = \"N/A\"\nif (max_resubdate > Date(1900, 0, 1)) {\n  resub_str = Text(max_resubdate, 'M/D/Y')\n}\n\nvar reviewcf =  $datapoint.Number_of_Reviews\nvar rejectcf = $datapoint.Number_of_Rejections\nvar resubmitcf = $datapoint.Number_of_Resubmissions\nvar acceptcf =  $datapoint.Accepted_Date\nvar completecf =  $datapoint.Completed_Date\n\nvar reviewcount = IIF(reviewcf != null, reviewcf, \"N/A\")\nvar rejectcount = IIF(rejectcf != null, rejectcf, \"N/A\")\nvar resubmitcount = IIF(resubmitcf != null, resubmitcf, \"N/A\")\nvar acceptdate = IIF(acceptcf != null, acceptcf, \"N/A\")\nvar completedate = IIF(completecf != null, completecf,